# ---- required ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Public address of the app (used in e-mail links)
APP_URL=https://kockolov.rs
# Only for a server without a web server of its own (deploy/README.md): Caddy on ports 80/443
# serves DOMAIN with HTTPS. Leave both commented on the myVesta server, where nginx has 80/443.
#DOMAIN=kockolov.rs
#COMPOSE_FILE=docker-compose.yml:deploy/caddy/compose.yml
# Server with old Docker 19.03 (Debian 9 + myVesta): ready-made image from GitHub, seccomp off
#COMPOSE_FILE=docker-compose.yml:deploy/myvesta/compose.docker19.yml
# The app itself only listens on 127.0.0.1 (handy for curl checks on the server)
APP_PORT=3100

# ---- access ----
# false = everyone must log in (closed testing). true = public site: browsing without an
# account, self sign-up with e-mail confirmation, robots.txt + sitemap.xml for search engines.
PUBLIC_MODE=false
# Self sign-up; defaults to PUBLIC_MODE when left empty (set false to keep sign-up closed)
REGISTRATION_OPEN=
# true when served over HTTPS (Caddy/nginx in front)
COOKIE_SECURE=true

# ---- morning e-mail (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# true only for a mail server with a self-signed certificate (e.g. the server's own Exim)
SMTP_TLS_INSECURE=false
MAIL_FROM=Kockolov <jutro@kockolov.rs>
# Account e-mails (confirmation, new password, invitation); empty = MAIL_FROM.
# With ACCOUNT_SMTP_USER set they log in to SMTP as that mailbox.
ACCOUNT_MAIL_FROM=Kockolov <nalog@kockolov.rs>
ACCOUNT_SMTP_USER=
ACCOUNT_SMTP_PASS=
# Gets an e-mail when a shop crawl fails or looks broken
ADMIN_ALERT_EMAIL=

# ---- schedules (Europe/Belgrade) ----
CRAWL_CRON=30 5 * * *
# morning e-mail and phone notifications about watched sets
DIGEST_CRON=0 7 * * *

# ---- phone notifications ----
# Nothing to set: the server makes its push key pair once and keeps it in the database.
# Only to bring a pair from elsewhere: VAPID_PUBLIC_KEY= and VAPID_PRIVATE_KEY=

# ---- crawler ----
# Identify ourselves honestly; add a contact address
CRAWLER_USER_AGENT=KockolovBot/0.1 (+https://github.com/redcellapps/kockolov; kontakt: m.djordjevic@shindiristudio.com)
CRAWLER_DELAY_MS=1200
# Limit to some shops (comma list). Empty = all.
CRAWLER_SHOPS=
