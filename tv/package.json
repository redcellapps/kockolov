{
  "name": "kockolov-tv",
  "version": "1.0.0",
  "description": "Kockolov za Smart TV (Samsung Tizen, LG webOS) — Lightning 3 / Blits",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host --port 5174",
    "build": "vite build",
    "build:tizen": "node scripts/build-tizen.mjs",
    "build:webos": "node scripts/build-webos.mjs",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@lightningjs/blits": "^2.14.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^8.2.3",
    "@types/qrcode": "^1.5.5",
    "terser": "^5.51.2",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
